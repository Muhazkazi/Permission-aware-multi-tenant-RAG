# Copy this file to .env to customize local, non-secret development settings.
APP_NAME=Permission-Aware Multi-Tenant RAG API
APP_ENV=development
APP_VERSION=0.1.0

# Replace these placeholders before starting MySQL. URL-encode special
# characters when placing a password in DATABASE_URL.
MYSQL_DATABASE=rag_db
MYSQL_USER=rag_user
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
DATABASE_URL=mysql+pymysql://rag_user:replace-with-a-strong-local-password@localhost:3306/rag_db

# Set a randomly generated value of at least 32 characters before using auth.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Optional absolute path for local execution. Compose uses a private named volume.
# UPLOAD_DIR=C:/private/rag/uploads
MAX_UPLOAD_BYTES=5242880
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Optional override. Local Python defaults to localhost; Compose uses qdrant.
# QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=rag_chunks_v1
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LLM_PROVIDER=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
